{
  "name": "crm-interno",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM interno: contactos, empresas, negocios, tareas, automatizaciones, informes.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.server.json && node -e \"require('fs').copyFileSync('server/schema.sql','dist/server/schema.sql')\" && vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "seed": "tsx --disable-warning=ExperimentalWarning server/seed.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.60.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
