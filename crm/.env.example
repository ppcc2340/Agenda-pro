# Puerto del servidor
PORT=3000
# Ruta de la base de datos SQLite (se crea sola)
DATABASE_PATH=./data/crm.db
# Secreto para firmar cookies y tokens (cámbialo en producción)
SESSION_SECRET=cambia-este-secreto
# Datos de demostración al arrancar con base de datos vacía (1 = sí, 0 = no)
SEED_DEMO=1
# Usuario administrador inicial (solo se crea si la base de datos está vacía)
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin1234!
# URL pública (para enlaces en emails, formularios y seguimiento)
PUBLIC_URL=http://localhost:3000
# Email saliente: fake (solo registra) o smtp
EMAIL_MODE=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=crm@tuempresa.com
