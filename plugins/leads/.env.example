# ── Correo (obligatorio para enviar y leer respuestas) ──────────────────
# Gmail: activa verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=contraseña_de_aplicacion

# ── Opcionales: mejoran la búsqueda (sin ellos se usa scraping) ──────────
# Google Places API (Google Maps estable y rápido): https://console.cloud.google.com
GOOGLE_API_KEY=
# Google Custom Search (búsqueda web oficial): https://programmablesearchengine.google.com
GOOGLE_CSE_ID=

# ── Opcional: personaliza el primer párrafo de cada correo con Claude ────
ANTHROPIC_API_KEY=

# Opcional: ruta a un Chromium ya instalado (si "playwright install" no es posible)
CHROMIUM_PATH=
