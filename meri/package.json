{
  "name": "meri",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test build",
    "db:generate": "pnpm --filter @meri/db generate",
    "db:migrate": "pnpm --filter @meri/db migrate",
    "eval": "pnpm --filter @meri/ai eval",
    "blockers": "node scripts/check-blockers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "status": "node scripts/phase-status.mjs",
    "test:coverage": "turbo run test -- --coverage"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "dependency-cruiser": "^16.5.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
