{
  "name": "meri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "report:margins": "tsx scripts/report-margins.ts",
    "keys:rotate": "tsx scripts/keys-rotate.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "dr:drill": "tsx scripts/dr-drill.ts",
    "e2e:fixture": "tsx scripts/e2e-fixtures.ts",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:deps",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test build && pnpm lint:deps && pnpm check:migrations && pnpm typecheck:scripts && pnpm test:scripts",
    "db:generate": "pnpm --filter @meri/db generate",
    "db:migrate": "pnpm --filter @meri/db migrate",
    "db:seed": "pnpm --filter @meri/db seed",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "beta:invite": "tsx scripts/beta-admin.ts invite",
    "beta:forget": "tsx scripts/beta-admin.ts forget",
    "flags:set": "tsx scripts/flags-set.ts",
    "eval": "pnpm --filter @meri/ai eval",
    "blockers": "node scripts/check-blockers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "status": "node scripts/phase-status.mjs",
    "test:coverage": "turbo run test -- --coverage",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "seed:perf": "tsx scripts/seed-perf.ts",
    "e2e": "pnpm --filter @meri/web e2e",
    "perf:hoy": "pnpm --filter @meri/web perf:hoy"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@meri/config": "workspace:*",
    "@meri/core": "workspace:*",
    "@meri/db": "workspace:*",
    "@meri/integrations": "workspace:*",
    "@meri/jobs": "workspace:*",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.6",
    "yaml": "2.9.1",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "braces": ">=3.0.3"
    }
  }
}
