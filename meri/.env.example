# Copy to .env (never commit .env). Claude Code must never read .env; use `pnpm blockers`.
NODE_ENV=development
# Deployment environment (defaults to NODE_ENV). production forbids fake adapters; development allows them even on an optimized build.
APP_ENV=
# Required (=1) only to run fakes on an optimized build (E2E, pnpm demo). Never set it in a deployment.
ALLOW_FAKES_ON_PRODUCTION_BUILD=
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_DOMAIN=localhost

# App role (no SUPERUSER, no BYPASSRLS). Created by the migrations when run with the admin URL.
DATABASE_URL=postgres://meri_app:meri_app@localhost:5432/meri
# Owner role, used only by `pnpm db:migrate`
DATABASE_ADMIN_URL=postgres://meri:meri@localhost:5432/meri
DATABASE_URL_TEST=postgres://meri_app:meri_app@localhost:5432/meri_test
DATABASE_ADMIN_URL_TEST=postgres://meri:meri@localhost:5432/meri_test
REDIS_URL=redis://localhost:6379

# Session (Auth.js). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-dev-only-secret-32-bytes-minimum
# Shared secret between web and api for the internal auth bootstrap route
INTERNAL_API_SECRET=change-me-dev-only-internal-secret
# Canonical web URL for Auth.js callbacks (required in production)
AUTH_URL=http://localhost:3000
# Reverse-proxy hops in front of the API (0 locally; 1 behind a load balancer)
TRUST_PROXY_HOPS=0

# Modes: fake (default) or live. See docs/blockers/README.md
GOOGLE_MODE=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Token verified on Calendar push notifications (X-Goog-Channel-Token). Generate with: openssl rand -hex 16
GOOGLE_CALENDAR_CHANNEL_TOKEN=dev-calendar-channel-token

AI_MODE=fake
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MONTHLY_COST_CAP_USD_PER_USER=6
# Optional: {"claude-haiku-5-5":{"input":1,"output":5,"cacheRead":0.1,"cacheWrite":1.25}} (USD per million tokens)
AI_PRICES_JSON=

STRIPE_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_PLUS=
STRIPE_PRICE_PRO_PLUS_ANNUAL=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=
# Estimated infrastructure cost per user and month (USD) for the margin report.
INFRA_COST_USD_PER_USER=3

ANALYTICS_MODE=noop
SENTRY_DSN=
POSTHOG_KEY=

# KMS: local (dev only), aws or gcp
KMS_PROVIDER=local
KMS_KEY_ID=
# 32 random bytes, base64. Dev only. Generate with: openssl rand -base64 32
LOCAL_MASTER_KEY=9Q449ubbvnSutHU69XwrIxPzJwDnO1ZjPXgbZU9Wbfo=

# Demo / prototype
DEMO_MODE=0
# Freeze the clock for deterministic demos and E2E (ISO 8601). Empty = real clock.
DEMO_NOW=
# Interface the api and the worker health server listen on (pnpm demo forces 127.0.0.1 unless --public).
LISTEN_HOST=0.0.0.0
