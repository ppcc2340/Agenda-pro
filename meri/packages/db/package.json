{
  "name": "@meri/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, RLS helpers and repositories.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "echo \"no build: consumed from src\"",
    "build:migrate": "tsup src/migrate-cli.ts --format esm --platform node --target node22 --out-dir dist --clean"
  },
  "dependencies": {
    "@meri/config": "workspace:*",
    "@meri/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.4",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
